@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Resetuj hasło";
}

<style>
    .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        position: relative;
        overflow: hidden;
    }

    .login-container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.1) 0%, transparent 50%),
                    radial-gradient(circle at 80% 80%, rgba(255,255,255,0.05) 0%, transparent 50%);
        pointer-events: none;
    }

    .login-box {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 500px;
        padding: 2rem;
    }

    .login-card {
        background: white;
        border-radius: 1.5rem;
        padding: 3.5rem 2.5rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        animation: slideInUp 0.6s ease-out;
    }

    .login-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .login-header h2 {
        font-size: 2rem;
        font-weight: 800;
        color: #172033;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
    }

    .login-header p {
        color: #647084;
        font-size: 1rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-floating label {
        color: #647084;
        font-weight: 600;
    }

    .form-floating input {
        border: 2px solid #e1e9f8;
        border-radius: 0.75rem;
        padding-left: 1rem;
        padding-right: 1rem;
    }

    .form-floating input:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
    }

    .login-button {
        width: 100%;
        padding: 0.875rem;
        font-size: 1.1rem;
        font-weight: 700;
        border-radius: 0.75rem;
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        color: white;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 8px 20px rgba(13, 110, 253, 0.3);
    }

    .login-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(13, 110, 253, 0.4);
    }

    .validation-errors {
        background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
        border: 2px solid #dc3545;
        border-radius: 1rem;
        padding: 1rem;
        margin-bottom: 1.5rem;
        color: #842029;
        font-weight: 500;
        animation: slideInDown 0.4s ease-out;
    }

    .validation-errors ul {
        margin: 0;
        padding-left: 1.25rem;
    }

    .validation-errors li {
        margin-bottom: 0.5rem;
    }

    .text-danger {
        color: #dc3545;
        font-size: 0.85rem;
        margin-top: 0.3rem;
        display: block;
    }
</style>

<div class="login-container">
    <div class="login-box">
        <div class="login-card">
            <div class="login-header">
                <h2><i class="bi bi-key"></i> Resetuj hasło</h2>
                <p>Ustaw nowe bezpieczne hasło do konta</p>
            </div>

            <form method="post" novalidate>
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="validation-errors">
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }

                <input asp-for="Input.Code" type="hidden" />

                <div class="form-group">
                    <div class="form-floating">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nazwa@example.com" />
                        <label asp-for="Input.Email" class="form-label"><i class="bi bi-envelope"></i> Adres e-mail</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-floating">
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="hasło" />
                        <label asp-for="Input.Password" class="form-label"><i class="bi bi-lock"></i> Nowe hasło</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-floating">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="hasło" />
                        <label asp-for="Input.ConfirmPassword" class="form-label"><i class="bi bi-lock"></i> Potwierdź hasło</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="login-button">
                    <i class="bi bi-check-circle"></i> Resetuj hasło
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
