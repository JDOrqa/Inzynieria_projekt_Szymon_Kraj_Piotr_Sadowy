@model IEnumerable<KomisSamochodowy.Models.Rezerwacja>
@{
    ViewData["Title"] = "Moje Rezerwacje";
}

<div class="container py-4">
    <h1 class="display-6 fw-bold mb-4">Moje Rezerwacje</h1>

    @if (TempData["Sukces"] != null)
    {
        <div class="alert alert-success">@TempData["Sukces"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">Nie masz obecnie żadnych aktywnych rezerwacji.</div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Samochód</th>
                            <th>Data rezerwacji</th>
                            <th>Cena</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.Samochod?.Marka?.Nazwa @item.Samochod?.Model?.Nazwa</div>
                                    <small class="text-muted">Rocznik: @item.Samochod?.RokProdukcji</small>
                                </td>
                                <td>@item.DataRezerwacji.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="fw-bold text-success">@item.Samochod?.Cena.ToString("N0") PLN</td>
                                <td class="text-end">
                                    <form asp-action="Anuluj" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Czy na pewno chcesz anulować tę rezerwację?');">
                                            Anuluj rezerwację
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>