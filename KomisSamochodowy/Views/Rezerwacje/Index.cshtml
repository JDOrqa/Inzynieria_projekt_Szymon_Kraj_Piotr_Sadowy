@model IEnumerable<KomisSamochodowy.Models.Rezerwacja>
@{
    ViewData["Title"] = "Moje Rezerwacje";
}

<style>
    .header-section {
        background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
        border-radius: 1.5rem;
        padding: 2rem;
        margin-bottom: 2rem;
        animation: slideInDown 0.6s ease-out;
    }

    .reservation-card {
        background: white;
        border-radius: 1.25rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 10px 30px rgba(23, 32, 51, 0.08);
        border-left: 5px solid #0d6efd;
        transition: all 0.3s ease;
        animation: fadeInUp 0.6s ease-out;
    }

    .reservation-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 50px rgba(13, 110, 253, 0.15);
    }

    .reservation-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #e1e9f8;
    }

    .car-info h4 {
        font-size: 1.3rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 0.5rem;
    }

    .car-info p {
        color: #647084;
        font-size: 0.95rem;
        margin: 0.25rem 0;
    }

    .car-info i {
        margin-right: 0.5rem;
        color: #0d6efd;
    }

    .reservation-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
    }

    .detail-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #647084;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }

    .detail-value {
        font-size: 1.3rem;
        font-weight: 700;
        color: #172033;
    }

    .detail-value.price {
        color: #198754;
        font-size: 1.5rem;
    }

    .detail-value.date {
        color: #0d6efd;
        font-family: 'Courier New', monospace;
    }

    .reservation-actions {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
    }

    .empty-state-container {
        text-align: center;
        padding: 3rem 2rem;
        background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
        border-radius: 1.5rem;
        border: 2px dashed #0d6efd;
        animation: fadeInUp 0.6s ease-out;
    }

    .empty-state-icon {
        font-size: 4rem;
        color: #0d6efd;
        margin-bottom: 1rem;
        animation: float 3s ease-in-out infinite;
    }

    .empty-state-container h3 {
        color: #172033;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .empty-state-container p {
        color: #647084;
        font-size: 1.05rem;
        margin-bottom: 1.5rem;
    }

    .alert-custom {
        border-radius: 1rem;
        border: none;
        padding: 1.25rem 1.5rem;
        animation: slideInDown 0.4s ease-out;
    }
</style>

<div class="header-section">
    <div>
        <span class="section-kicker"><i class="bi bi-bookmark"></i> MOJE REZERWACJE</span>
        <h1 class="display-6 fw-bold mb-1">Zarezerwowane pojazdy</h1>
        <p class="text-muted mb-0">Przeglądaj swoją listę zarezerwowanych samochodów</p>
    </div>
</div>

@if (TempData["Sukces"] != null)
{
    <div class="alert alert-success alert-custom" role="alert">
        <i class="bi bi-check-circle"></i> <strong>Sukces!</strong> @TempData["Sukces"]
    </div>
}

@if (!Model.Any())
{
    <div class="empty-state-container">
        <div class="empty-state-icon">
            <i class="bi bi-bookmark"></i>
        </div>
        <h3>Brak rezerwacji</h3>
        <p>Nie masz obecnie żadnych zarezerwowanych pojazdów. Przeglądaj naszą ofertę i zarezerwuj interesujący Cię samochód!</p>
        <a href="@Url.Action("Oferty", "Samochody")" class="btn btn-primary btn-lg">
            <i class="bi bi-tags"></i> Przeglądaj oferty
        </a>
    </div>
}
else
{
    <div class="container-fluid px-0">
        @foreach (var item in Model)
        {
            <div class="reservation-card">
                <div class="reservation-header">
                    <div class="car-info">
                        <h4>
                            <i class="bi bi-car-front"></i> @item.Samochod?.Marka?.Nazwa @item.Samochod?.Model?.Nazwa
                        </h4>
                        <p>
                            <i class="bi bi-calendar-event"></i> Rocznik: <strong>@item.Samochod?.RokProdukcji</strong>
                        </p>
                        <p>
                            <i class="bi bi-droplet"></i> Paliwo: <strong>@item.Samochod?.Paliwo</strong>
                        </p>
                        <p>
                            <i class="bi bi-speedometer"></i> Przebieg: <strong>@item.Samochod?.Przebieg.ToString("N0") km</strong>
                        </p>
                    </div>
                </div>

                <div class="reservation-details">
                    <div class="detail-item">
                        <span class="detail-label">Data rezerwacji</span>
                        <span class="detail-value date">
                            <i class="bi bi-calendar"></i> @item.DataRezerwacji.ToString("dd.MM.yyyy HH:mm")
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Cena pojazdu</span>
                        <span class="detail-value price">
                            <i class="bi bi-currency-dollar"></i> @item.Samochod?.Cena.ToString("N0") PLN
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Status</span>
                        <span class="badge text-bg-success" style="width: fit-content; font-size: 0.95rem;">
                            <i class="bi bi-check-circle"></i> Zarezerwowany
                        </span>
                    </div>
                </div>

                <div class="reservation-actions">
                    <form asp-action="Anuluj" asp-route-id="@item.Id" method="post" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Czy na pewno chcesz anulować tę rezerwację? Tej akcji nie można cofnąć.');">
                            <i class="bi bi-x-circle"></i> Anuluj rezerwację
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}