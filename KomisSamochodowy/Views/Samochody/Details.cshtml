@model KomisSamochodowy.Models.Samochod

@{
    ViewData["Title"] = $"{Model.Marka?.Nazwa} {Model.Model?.Nazwa}";
    var isClient = User.IsInRole("Klient");
    var gallery = (Model.GaleriaZdjec ?? string.Empty)
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}

<style>
    .back-button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #0d6efd;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 2rem;
        transition: all 0.3s ease;
        animation: slideInLeft 0.6s ease-out;
    }

    .back-button:hover {
        color: #0a58ca;
        gap: 0.75rem;
    }

    .details-container {
        animation: fadeInUp 0.6s ease-out;
    }

    .details-image-container {
        position: relative;
        border-radius: 1.5rem;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(23, 32, 51, 0.15);
        animation: slideInLeft 0.6s ease-out;
    }

    .details-info-card {
        border-radius: 1.5rem;
        padding: 2.5rem;
        background: white;
        box-shadow: 0 20px 50px rgba(23, 32, 51, 0.1);
        animation: slideInRight 0.6s ease-out;
        position: relative;
    }

    .info-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 2px solid #e1e9f8;
    }

    .info-header h1 {
        font-size: 2rem;
        font-weight: 800;
        color: #172033;
    }

    .details-specs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 2rem;
        padding: 1.5rem;
        background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
        border-radius: 1rem;
        border-left: 4px solid #0d6efd;
    }

    .spec-item {
        display: flex;
        flex-direction: column;
    }

    .spec-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #647084;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }

    .spec-value {
        font-size: 1.3rem;
        font-weight: 700;
        color: #172033;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .price-section {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        color: white;
        padding: 2rem;
        border-radius: 1rem;
        margin-bottom: 1.5rem;
        text-align: center;
        box-shadow: 0 10px 30px rgba(13, 110, 253, 0.2);
    }

    .price-label {
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        opacity: 0.95;
        margin-bottom: 0.5rem;
    }

    .price-value {
        font-size: 2.5rem;
        font-weight: 800;
    }

    .action-button {
        width: 100%;
        padding: 1rem;
        font-size: 1.1rem;
        font-weight: 700;
        border-radius: 0.75rem;
        transition: all 0.3s ease;
    }

    .alert-warning {
        border-radius: 1rem;
        border: none;
        background: linear-gradient(135deg, #fff3cd 0%, #ffe69c 100%);
        color: #664d03;
    }

    .gallery-section {
        margin-top: 3rem;
        animation: fadeInUp 0.6s ease-out 0.2s both;
    }

    .gallery-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 1rem;
    }

    .gallery-image {
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(23, 32, 51, 0.1);
        height: 120px;
        object-fit: cover;
    }

    .gallery-image:hover {
        transform: scale(1.05);
        box-shadow: 0 10px 30px rgba(13, 110, 253, 0.2);
    }

    .description-section {
        background: white;
        border-radius: 1.5rem;
        padding: 2rem;
        margin-top: 2rem;
        box-shadow: 0 10px 30px rgba(23, 32, 51, 0.08);
        border-left: 4px solid #6f42c1;
        animation: fadeInUp 0.6s ease-out 0.3s both;
    }

    .description-section h2 {
        font-size: 1.3rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 1rem;
    }

    .description-section p {
        color: #647084;
        line-height: 1.8;
        font-size: 1.05rem;
    }

    .modal {
        display: none;
        position: fixed;
        z-index: 1050;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.8);
        animation: fadeInUp 0.3s ease-out;
    }

    .modal.show {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-content-img {
        max-width: 90%;
        max-height: 90vh;
        border-radius: 1rem;
    }

    .close {
        color: white;
        position: fixed;
        top: 20px;
        right: 30px;
        font-size: 40px;
        font-weight: 700;
        cursor: pointer;
        z-index: 1051;
        transition: all 0.3s ease;
    }

    .close:hover {
        color: #0d6efd;
    }
</style>

<div class="container-fluid px-4 py-4">
    @if (TempData["Sukces"] != null)
    {
        <div class="alert alert-success alert-custom" role="alert">
            <i class="bi bi-check-circle"></i> <strong>Sukces!</strong> @TempData["Sukces"]
        </div>
    }

    <a asp-action="Oferty" class="back-button">
        <i class="bi bi-arrow-left"></i> Wróć do ofert
    </a>

    <div class="details-container">
        <div class="row g-4 align-items-start">
            <div class="col-lg-7">
                <div class="details-image-container">
                    @if (string.IsNullOrWhiteSpace(Model.ZdjecieUrl))
                    {
                        <div class="details-image image-placeholder">
                            <i class="bi bi-car-front"></i>
                        </div>
                    }
                    else
                    {
                        <img src="@Model.ZdjecieUrl" class="details-image" alt="@Model.Marka?.Nazwa @Model.Model?.Nazwa" />
                    }
                </div>
            </div>

            <div class="col-lg-5">
                <div class="details-info-card">
                    <div class="info-header">
                        <div>
                            <span class="section-kicker">OFERTA #@Model.Id</span>
                            <h1>@Model.Marka?.Nazwa @Model.Model?.Nazwa</h1>
                        </div>
                        <span class="badge @(Model.Status == "Zarezerwowany" ? "text-bg-warning" : "text-bg-success")">
                            @Model.Status
                        </span>
                    </div>

                    <div class="details-specs">
                        <div class="spec-item">
                            <span class="spec-label"><i class="bi bi-calendar-event"></i> Rocznik</span>
                            <span class="spec-value">@Model.RokProdukcji</span>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label"><i class="bi bi-speedometer"></i> Przebieg</span>
                            <span class="spec-value">@Model.Przebieg.ToString("N0") km</span>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label"><i class="bi bi-droplet"></i> Paliwo</span>
                            <span class="spec-value">@Model.Paliwo</span>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label"><i class="bi bi-info-circle"></i> Status</span>
                            <span class="spec-value">
                                <span class="badge @(Model.Status == "Dostępny" ? "bg-success" : Model.Status == "Zarezerwowany" ? "bg-warning" : "bg-danger")">
                                    @Model.Status
                                </span>
                            </span>
                        </div>
                    </div>

                    <div class="price-section">
                        <div class="price-label">Cena pojazdu</div>
                        <div class="price-value">@Model.Cena.ToString("N0") PLN</div>
                    </div>

                    @if (isClient && Model.Status == "Dostępny")
                    {
                        <form asp-action="Reserve" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary action-button">
                                <i class="bi bi-bookmark-heart"></i> Zarezerwuj samochód
                            </button>
                        </form>
                    }
                    else if (Model.Status == "Zarezerwowany")
                    {
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-info-circle"></i> Ten samochód jest już zarezerwowany. Sprawdź inne oferty.
                        </div>
                    }
                    else if (Model.Status == "Sprzedany")
                    {
                        <div class="alert alert-danger mb-0">
                            <i class="bi bi-x-circle"></i> Ten samochód został już sprzedany.
                        </div>
                    }
                    else if (!User.Identity?.IsAuthenticated ?? true)
                    {
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary action-button">
                            <i class="bi bi-box-arrow-in-right"></i> Zaloguj się, aby zarezerwować
                        </a>
                    }
                </div>
            </div>

            @if (gallery.Length > 0)
            {
                <div class="col-12 gallery-section">
                    <h2 class="gallery-title">
                        <i class="bi bi-image"></i> Galeria zdjęć pojazdu
                    </h2>
                    <div class="gallery-grid">
                        @foreach (var image in gallery)
                        {
                            <img src="@image" class="gallery-image rounded-3" alt="Zdjęcie samochodu" loading="lazy" onclick="openModal('@image')" />
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Opis))
            {
                <div class="col-12 description-section">
                    <h2><i class="bi bi-file-text"></i> O tym pojazdie</h2>
                    <p>@Model.Opis</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal dla zdjęć -->
<div id="imageModal" class="modal" onclick="closeModal()">
    <span class="close" onclick="closeModal()">&times;</span>
    <img id="modalImage" class="modal-content-img" src="" alt="">
</div>

<script>
    function openModal(src) {
        const modal = document.getElementById('imageModal');
        const img = document.getElementById('modalImage');
        img.src = src;
        modal.classList.add('show');
    }

    function closeModal() {
        const modal = document.getElementById('imageModal');
        modal.classList.remove('show');
    }

    // Zamykanie modala po kliknięciu ESC
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeModal();
        }
    });
</script>