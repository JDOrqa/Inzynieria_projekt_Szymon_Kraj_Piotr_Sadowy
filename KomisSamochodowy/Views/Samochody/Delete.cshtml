@model KomisSamochodowy.Models.Samochod

@{
    ViewData["Title"] = "Usuń samochód";
}

<h1>Usuń samochód</h1>
<h3>Czy na pewno chcesz usunąć to auto z oferty?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Marka</dt>
        <dd class="col-sm-10">@Model.Marka</dd>

        <dt class="col-sm-2">Model</dt>
        <dd class="col-sm-10">@Model.Model</dd>

        <dt class="col-sm-2">Rok produkcji</dt>
        <dd class="col-sm-10">@Model.RokProdukcji</dd>

        <dt class="col-sm-2">Cena</dt>
        <dd class="col-sm-10">@Model.Cena PLN</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Usuń auto" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Powrót do listy</a>
    </form>
</div>