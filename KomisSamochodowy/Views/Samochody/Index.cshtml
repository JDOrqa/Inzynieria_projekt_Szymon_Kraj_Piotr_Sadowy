@model IEnumerable<KomisSamochodowy.Models.Samochod>

@{
    ViewData["Title"] = "Panel pojazdów";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="section-kicker">ZARZĄDZANIE</span>
            <h1 class="display-6 fw-bold mb-1">Panel pojazdów</h1>
            <p class="text-muted mb-0">Pełna lista samochodów w bazie.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Dodaj nowy pojazd
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Marka i model</th>
                        <th>Rocznik</th>
                        <th>Cena</th>
                        <th>Status</th>
                        <th class="text-end">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted">#@item.Id</td>
                            <td>
                                <div class="fw-semibold">@item.Marka @item.Model</div>
                                <small class="text-muted">@item.Paliwo · @item.Przebieg.ToString("N0") km</small>
                            </td>
                            <td>@item.RokProdukcji</td>
                            <td class="fw-semibold">@item.Cena.ToString("N0") PLN</td>
                            <td>
                                <span class="badge status-badge status-@item.Status.ToLowerInvariant()">@item.Status</span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Szczegóły"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edytuj"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Usuń"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>