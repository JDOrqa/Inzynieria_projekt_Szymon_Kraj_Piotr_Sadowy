@model IEnumerable<KomisSamochodowy.Models.Samochod>
@{
    ViewData["Title"] = "Lista samochodów";
    var canManageCars = User.IsInRole("Administrator") || User.IsInRole("Sprzedawca");
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="m-0">Oferta aut</h1>
        @if (canManageCars)
        {
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Dodaj nowe auto
            </a>
        }
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover align-middle mb-0 text-center" style="table-layout: fixed;">
            <thead class="table-dark">
                <tr>
                    <th scope="col" style="width: 20%;">Marka</th>
                    <th scope="col" style="width: 20%;">Model</th>
                    <th scope="col" style="width: 20%;">Rok produkcji</th>
                    <th scope="col" style="width: 20%;">Cena</th>
                    @if (canManageCars)
                    {
                        <th scope="col" style="width: 20%;">Akcje</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Marka</td>
                            <td>@item.Model</td>
                            <td>@item.RokProdukcji</td>
                            <td>@item.Cena.ToString("N2") PLN</td>
                            @if (canManageCars)
                            {
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-2">Edytuj</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Usuń</a>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(canManageCars ? 5 : 4)" class="py-4 text-muted">
                            <em>Brak aut w bazie. Dodaj jakieś!</em>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>