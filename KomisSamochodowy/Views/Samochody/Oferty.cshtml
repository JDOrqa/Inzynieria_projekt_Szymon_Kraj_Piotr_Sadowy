@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<KomisSamochodowy.Models.Samochod>
@{
    ViewData["Title"] = "Oferty samochodów";
}

<style>
    .search-filter-section {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        animation: slideInDown 0.6s ease-out;
    }

    .search-filter-section h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: #172033;
        margin: 0;
        min-width: 200px;
    }

    .search-controls {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        flex: 1;
        min-width: 250px;
    }

    .search-input {
        flex: 1;
        min-width: 150px;
        max-width: 300px;
    }

    .search-input .input-group {
        border-radius: 0.75rem;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(13, 110, 253, 0.1);
    }

    .input-group-text {
        border: 2px solid #0d6efd !important;
        color: #0d6efd;
        background: white !important;
    }

    .search-input .form-control {
        border: 2px solid #0d6efd !important;
        padding: 0.6rem 0.75rem;
        font-weight: 500;
        font-size: 0.95rem;
    }

    .search-input .form-control::placeholder {
        color: #8d99aa;
    }

    .fuel-filter {
        min-width: 130px;
        max-width: 150px;
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        margin-top: 3rem;
        margin-bottom: 2rem;
        animation: fadeInUp 0.6s ease-out;
    }

    .no-results {
        text-align: center;
        padding: 4rem 2rem;
        background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
        border: 2px dashed #0d6efd;
        border-radius: 1.5rem;
        margin-top: 2rem;
    }

    .no-results i {
        font-size: 4rem;
        color: #0d6efd;
        margin-bottom: 1rem;
        display: block;
        animation: float 3s ease-in-out infinite;
    }

    .no-results h3 {
        color: #172033;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .no-results p {
        color: #647084;
        font-size: 1.05rem;
    }
</style>

<div class="container-fluid px-4 py-4">
    <div class="hero-panel rounded-4 p-4 p-md-5 mb-5">
        <span class="section-kicker"><i class="bi bi-tags"></i> KOMIS SAMOCHODOWY</span>
        <h1 class="display-5 fw-bold mt-3 mb-2">Znajdź idealny samochód</h1>
        <p class="lead mb-0">Przeglądaj naszą ofertę pojazd ów, które zostały dokładnie sprawdzone i przygotowane specjalnie dla Ciebie.</p>
    </div>

    <div class="search-filter-section">
        <div>
            <h2>Aktualne oferty</h2>
            <small class="text-muted">Strona @Model.PageNumber z @Model.PageCount (łącznie @Model.TotalItemCount pojazdów)</small>
        </div>
        <div class="search-controls">
            <div class="search-input">
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input id="offerSearch" type="search" class="form-control" placeholder="Szukaj marki lub modelu..." aria-label="Szukaj oferty" />
                </div>
            </div>
            <select id="fuelFilter" class="form-select fuel-filter" aria-label="Filtruj paliwo">
                <option value="">Wszystkie paliwa</option>
                <option>Benzyna</option>
                <option>Diesel</option>
                <option>Hybryda</option>
                <option>Elektryczny</option>
                <option>LPG</option>
            </select>
        </div>
    </div>

    <div id="offerGrid" class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-xl-4 offer-item" data-search="@item.Marka?.Nazwa @item.Model?.Nazwa @item.Paliwo" data-fuel="@item.Paliwo">
                <article class="card car-card h-100 border-0">
                    @if (string.IsNullOrWhiteSpace(item.ZdjecieUrl))
                    {
                        <div class="car-image image-placeholder">
                            <i class="bi bi-car-front"></i>
                        </div>
                    }
                    else
                    {
                        <img src="@item.ZdjecieUrl" class="card-img-top car-image" alt="@item.Marka?.Nazwa @item.Model?.Nazwa" loading="lazy" />
                    }
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <h3 class="h4 mb-1 fw-bold">
                                    <i class="bi bi-car-front"></i> @item.Marka?.Nazwa @item.Model?.Nazwa
                                </h3>
                                <span class="text-muted">
                                    <i class="bi bi-calendar-event"></i> Rocznik @item.RokProdukcji
                                </span>
                            </div>
                            @if (item.Status == "Zarezerwowany")
                            {
                                <span class="badge text-bg-warning">
                                    <i class="bi bi-bookmark-heart"></i> ZAREZERWOWANY
                                </span>
                            }
                        </div>
                        <div class="car-specs mt-3 mb-4">
                            <span>
                                <i class="bi bi-speedometer"></i> <strong>@item.Przebieg.ToString("N0")</strong> km
                            </span>
                            <span>
                                <i class="bi bi-droplet"></i> @item.Paliwo
                            </span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-auto gap-3">
                            <div class="car-price">
                                <i class="bi bi-currency-dollar"></i> @item.Cena.ToString("N0") <small>PLN</small>
                            </div>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary">
                                <i class="bi bi-info-circle"></i> Szczegóły
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>

    @if (Model.TotalItemCount > 0)
    {
        <div class="pagination-container">
            @Html.PagedListPager(Model, page => Url.Action("Oferty", new { page }), new PagedListRenderOptions
            {
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" }
            })
        </div>
    }

    <div id="noOffers" class="no-results d-none">
        <i class="bi bi-search"></i>
        <h3>Nie znaleziono ofert</h3>
        <p class="mb-0">Spróbuj zmienić wyszukiwaną frazę lub wybrać inne kryteria filtrowania.</p>
    </div>
</div>

@section Scripts {
    <script>
        const filterOffers = () => {
            const query = document.getElementById('offerSearch').value.toLowerCase().trim();
            const fuel = document.getElementById('fuelFilter').value;
            const items = document.querySelectorAll('.offer-item');
            let visible = 0;
            items.forEach(item => {
                const matches = item.dataset.search.toLowerCase().includes(query) && (!fuel || item.dataset.fuel === fuel);
                item.classList.toggle('d-none', !matches);
                if (matches) visible++;
            });
            document.getElementById('noOffers').classList.toggle('d-none', visible !== 0);
        };
        document.getElementById('offerSearch')?.addEventListener('input', filterOffers);
        document.getElementById('fuelFilter')?.addEventListener('change', filterOffers);
    </script>
}