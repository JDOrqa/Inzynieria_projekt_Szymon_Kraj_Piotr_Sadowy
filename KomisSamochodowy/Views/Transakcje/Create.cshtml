@model KomisSamochodowy.Models.ViewModels.UtworzTransakcjeViewModel
@{
    ViewData["Title"] = "Rejestracja Sprzedaży";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h3 fw-bold mb-4">Rejestracja Sprzedaży</h1>

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Wybór Auta -->
                        <div class="form-group mb-3">
                            <label asp-for="SamochodId" class="control-label fw-semibold"></label>
                            <select asp-for="SamochodId" class="form-select" id="samochodSelect">
                                <option value="">-- Wybierz auto z oferty --</option>
                                @foreach (var auto in Model.DostepneSamochody)
                                {
                                    var cenaDlaJs = auto.Cena.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                    <option value="@auto.Id" data-cena="@cenaDlaJs">
                                        @auto.Marka?.Nazwa @auto.Model?.Nazwa (@auto.RokProdukcji) - @auto.Cena.ToString("N0") PLN
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="SamochodId" class="text-danger"></span>
                        </div>

                        <!-- WYBÓR KLIENTA (NOWY / ISTNIEJĄCY) -->
                        <div class="form-group mb-3 p-3 bg-light rounded border">
                            <label class="fw-semibold d-block mb-2">Klient</label>

                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" asp-for="CzyNowyKlient" value="false" id="radioIstniejacy" checked>
                                <label class="form-check-label" for="radioIstniejacy">Wybierz istniejącego klienta z bazy</label>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="radio" asp-for="CzyNowyKlient" value="true" id="radioNowy">
                                <label class="form-check-label" for="radioNowy">Zarejestruj nowego klienta</label>
                            </div>

                            <!-- Sekcja istniejącego klienta -->
                            <div id="sekcjaIstniejacy">
                                <select asp-for="KlientId" asp-items="Model.Klienci" class="form-select">
                                    <option value="">-- Wybierz klienta z listy --</option>
                                </select>
                                <span asp-validation-for="KlientId" class="text-danger"></span>
                            </div>

                            <!-- Sekcja nowego klienta -->
                            <div id="sekcjaNowy" class="d-none">
                                <div class="mb-2">
                                    <label asp-for="NowyKlientEmail" class="form-label"></label>
                                    <input asp-for="NowyKlientEmail" class="form-control" />
                                    <span asp-validation-for="NowyKlientEmail" class="text-danger"></span>
                                </div>
                                <div class="mb-2">
                                    <label asp-for="NowyKlientHaslo" class="form-label"></label>
                                    <input asp-for="NowyKlientHaslo" class="form-control" />
                                    <span asp-validation-for="NowyKlientHaslo" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Kwota i Data -->
                        <div class="form-group mb-3">
                            <label asp-for="Kwota" class="control-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="Kwota" class="form-control" type="number" step="0.01" id="kwotaInput" />
                                <span class="input-group-text">PLN</span>
                            </div>
                            <span asp-validation-for="Kwota" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="DataTransakcji" class="control-label fw-semibold"></label>
                            <input asp-for="DataTransakcji" class="form-control" type="datetime-local" />
                            <span asp-validation-for="DataTransakcji" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">Zatwierdź sprzedaż</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Powrót do historii</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // --- AUTOMATYCZNE UZUPELNIANIE CENY ---
            const samochodSelect = document.getElementById("samochodSelect");
            const kwotaInput = document.getElementById("kwotaInput");

            function aktualizujCene() {
                const selectedOption = samochodSelect.options[samochodSelect.selectedIndex];
                if (selectedOption && selectedOption.value !== "") {
                    const cena = selectedOption.getAttribute("data-cena");
                    if (cena) kwotaInput.value = parseFloat(cena).toFixed(2);
                } else {
                    kwotaInput.value = "";
                }
            }
            samochodSelect.addEventListener("change", aktualizujCene);

            // --- PRZEŁĄCZANIE KLIENTA ---
            const radioIstniejacy = document.getElementById("radioIstniejacy");
            const radioNowy = document.getElementById("radioNowy");
            const sekcjaIstniejacy = document.getElementById("sekcjaIstniejacy");
            const sekcjaNowy = document.getElementById("sekcjaNowy");

            function toggleKlient() {
                if (radioNowy.checked) {
                    sekcjaNowy.classList.remove("d-none");
                    sekcjaIstniejacy.classList.add("d-none");
                } else {
                    sekcjaNowy.classList.add("d-none");
                    sekcjaIstniejacy.classList.remove("d-none");
                }
            }
            radioIstniejacy.addEventListener("change", toggleKlient);
            radioNowy.addEventListener("change", toggleKlient);

            // Wywołaj na starcie (gdyby walidacja zwróciła błąd i nowy klient był wybrany)
            toggleKlient();
        });
    </script>
}