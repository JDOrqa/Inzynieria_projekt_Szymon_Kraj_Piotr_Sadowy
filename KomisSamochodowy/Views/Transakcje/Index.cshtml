@model IEnumerable<KomisSamochodowy.Models.Transakcja>
@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "Historia Sprzedaży";
    var users = ViewBag.Users as Dictionary<string, string>;
}

<style>
    .header-with-btn {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
        border-radius: 1.5rem;
        padding: 2rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1.5rem;
        animation: slideInDown 0.6s ease-out;
    }

    .header-with-btn h1 {
        margin: 0;
    }

    .table-wrapper {
        border-radius: 1.25rem;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(23, 32, 51, 0.08);
    }

    .table {
        margin-bottom: 0;
    }

    .table tbody tr {
        border-bottom: 1px solid #e1e9f8;
    }

    .table tbody tr:last-child {
        border-bottom: none;
    }

    .alert-custom {
        border-radius: 1rem;
        border: none;
        padding: 1.25rem 1.5rem;
        animation: slideInDown 0.4s ease-out;
    }

    .amount-badge {
        display: inline-block;
        background: linear-gradient(135deg, #198754 0%, #157347 100%);
        color: white;
        padding: 0.6rem 1rem;
        border-radius: 0.75rem;
        font-weight: 700;
        font-size: 1.1rem;
    }

    .user-badge {
        display: inline-block;
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        color: white;
        padding: 0.5rem 0.75rem;
        border-radius: 0.5rem;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .date-time {
        font-family: 'Courier New', monospace;
        color: #0d6efd;
        font-weight: 600;
    }

    .empty-state {
        text-align: center;
        padding: 3rem 2rem;
        background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
        border-radius: 1.5rem;
        border: 2px dashed #0d6efd;
        animation: fadeInUp 0.6s ease-out;
    }

    .empty-state-icon {
        font-size: 4rem;
        color: #0d6efd;
        margin-bottom: 1rem;
        animation: float 3s ease-in-out infinite;
    }

    .empty-state h3 {
        color: #172033;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .empty-state p {
        color: #647084;
        font-size: 1.05rem;
        margin-bottom: 1.5rem;
    }
</style>

<div class="header-with-btn">
    <div>
        <span class="section-kicker"><i class="bi bi-cash-coin"></i> SPRZEDAŻ</span>
        <h1 class="display-6 fw-bold mb-1">Historia Sprzedaży</h1>
        <p class="text-muted mb-0">Pełna historia transakcji sprzedaży pojazdów</p>
    </div>
    <a asp-action="Create" class="btn btn-success btn-lg">
        <i class="bi bi-plus-circle"></i> Nowa transakcja
    </a>
</div>

@if (TempData["Sukces"] != null)
{
    <div class="alert alert-success alert-custom" role="alert">
        <i class="bi bi-check-circle"></i> <strong>Sukces!</strong> @TempData["Sukces"]
    </div>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="bi bi-graph-up"></i>
        </div>
        <h3>Brak transakcji</h3>
        <p>Nie zostały jeszcze zarejestrowane żadne transakcje sprzedaży. Zacznij od dodania pierwszej transakcji.</p>
        <a asp-action="Create" class="btn btn-success btn-lg">
            <i class="bi bi-plus-circle"></i> Zarejestruj sprzedaż
        </a>
    </div>
}
else
{
    <div class="table-wrapper">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th style="width: 15%;"><i class="bi bi-calendar"></i> Data</th>
                        <th style="width: 20%;"><i class="bi bi-car-front"></i> Samochód</th>
                        <th style="width: 15%;"><i class="bi bi-person"></i> Klient</th>
                        <th style="width: 15%;"><i class="bi bi-person-badge"></i> Sprzedawca</th>
                        <th style="width: 20%; text-align: right;"><i class="bi bi-currency-dollar"></i> Kwota</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="date-time">@item.DataTransakcji.ToString("dd.MM.yyyy HH:mm")</span>
                            </td>
                            <td>
                                <div class="fw-semibold">
                                    <i class="bi bi-car-front"></i> @item.Samochod?.Marka @item.Samochod?.Model
                                </div>
                                <small class="text-muted">ID: @item.SamochodId</small>
                            </td>
                            <td>
                                <span class="user-badge">
                                    <i class="bi bi-person-circle"></i>
                                    @(users.ContainsKey(item.KlientId) ? users[item.KlientId] : "Nieznany klient")
                                </span>
                            </td>
                            <td>
                                <span class="user-badge" style="background: linear-gradient(135deg, #6f42c1 0%, #5a32a3 100%);">
                                    <i class="bi bi-person-check"></i>
                                    @(users.ContainsKey(item.SprzedawcaId) ? users[item.SprzedawcaId] : "Nieznany sprzedawca")
                                </span>
                            </td>
                            <td style="text-align: right;">
                                <span class="amount-badge">
                                    @item.Kwota.ToString("N0") PLN
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}