@model List<KomisSamochodowy.Controllers.UserWithRolesViewModel>
@{
    ViewData["Title"] = "Panel administratora";
}

<h1>Panel administratora</h1>
<p class="text-muted">Zarządzanie rolami użytkowników i blokadą kont.</p>

@if (TempData["Sukces"] != null)
{
    <div class="alert alert-success">@TempData["Sukces"]</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>E-mail</th>
            <th>Aktualna rola</th>
            <th>Status konta</th>
            <th>Zmień rolę</th>
            <th>Blokada</th> <!-- NOWA KOLUMNA -->
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Email</td>
                <td>@(u.Roles.Any() ? string.Join(", ", u.Roles) : "— brak —")</td>
                <td>
                    @if (u.IsLocked)
                    {
                        <span class="badge bg-danger">ZABLOKOWANE</span>
                    }
                    else
                    {
                        <span class="badge bg-success">AKTYWNE</span>
                    }
                </td>
                <td>
                    <form asp-action="ZmienRole" method="post" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@u.UserId" />
                        <select name="nowaRola" class="form-select form-select-sm" style="max-width:150px;">
                            @foreach (var r in (List<string>)ViewBag.WszystkieRole)
                            {
                                <option value="@r" selected="@(u.Roles.Contains(r) ? "selected" : null)">
                                    @r
                                </option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary">Zmień</button>
                    </form>
                </td>
                <td>
                    <!-- NOWY FORMULARZ BLOKADY -->
                    <form asp-action="PrzelaczBlokade" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@u.UserId" />
                        @if (u.IsLocked)
                        {
                            <button type="submit" class="btn btn-sm btn-outline-success" title="Odblokuj"><i class="bi bi-unlock"></i> Odblokuj</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Zablokuj"><i class="bi bi-lock"></i> Zablokuj</button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>