@{
    ViewData["Title"] = "Zarządzanie Słownikami";
    var marki = ViewBag.Marki as List<KomisSamochodowy.Models.Marka>;
    var modele = ViewBag.Modele as List<KomisSamochodowy.Models.Model>;
}

<style>
    .header-section {
        background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
        border-radius: 1.5rem;
        padding: 2rem;
        margin-bottom: 2rem;
        animation: slideInDown 0.6s ease-out;
    }

    .form-row-inline {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        align-items: flex-end;
    }

    .form-row-inline input,
    .form-row-inline select {
        flex: 1;
        min-width: 150px;
    }

    .form-row-inline .btn {
        white-space: nowrap;
        flex-shrink: 0;
    }

    .card {
        border-radius: 1.25rem !important;
        box-shadow: 0 10px 30px rgba(23, 32, 51, 0.08) !important;
        animation: fadeInUp 0.6s ease-out;
    }

    .card-header {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%) !important;
        border-radius: 1.25rem 1.25rem 0 0 !important;
        border: none !important;
    }

    .card-header.bg-secondary {
        background: linear-gradient(135deg, #6f42c1 0%, #5a32a3 100%) !important;
    }

    .alert-custom {
        border-radius: 1rem;
        border: none;
        animation: slideInDown 0.4s ease-out;
        padding: 1.25rem 1.5rem;
    }

    .list-group {
        border-radius: 1rem;
    }

    .list-group-item {
        border: 1px solid #e1e9f8;
        border-radius: 0.75rem;
        margin-bottom: 0.5rem;
        transition: all 0.3s ease;
    }

    .list-group-item:hover {
        background: rgba(13, 110, 253, 0.03);
        border-color: #0d6efd;
    }

    .btn-success {
        background: linear-gradient(135deg, #198754 0%, #157347 100%);
        border: none;
        font-weight: 600;
        white-space: nowrap;
        padding: 0.6rem 1.5rem;
    }

    .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(25, 135, 84, 0.3);
    }
</style>

<div class="container-fluid px-4 py-4">
    <div class="header-section">
        <span class="section-kicker"><i class="bi bi-book"></i> ADMINISTRACJA</span>
        <h1 class="display-6 fw-bold mb-1">Zarządzanie Słownikami</h1>
        <p class="text-muted mb-0">Zarządzaj markami i modelami pojazdów w systemie</p>
    </div>

    @if (TempData["Sukces"] != null)
    {
        <div class="alert alert-success alert-custom" role="alert">
            <i class="bi bi-check-circle"></i> <strong>Sukces!</strong> @TempData["Sukces"]
        </div>
    }

    <div class="row g-4">
        <!-- Sekcja Marek -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header text-white p-3">
                    <h2 class="h5 mb-0"><i class="bi bi-bookmark"></i> Zarządzaj Markami</h2>
                </div>
                <div class="card-body">
                    <form asp-action="DodajMarke" method="post" class="form-row-inline mb-4">
                        <input type="text" name="nazwaMarki" class="form-control" placeholder="Nazwa marki..." required />
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-plus-circle"></i> Dodaj
                        </button>
                    </form>

                    <h5 class="mt-3 mb-3">
                        <i class="bi bi-list-ul"></i> Lista Marek
                    </h5>
                    <div style="max-height: 450px; overflow-y: auto;">
                        @if (marki != null && marki.Count > 0)
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var marka in marki)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                        <div>
                                            <strong class="text-primary">@marka.Nazwa</strong>
                                            <small class="text-muted d-block">ID: @marka.Id</small>
                                        </div>
                                        <form asp-action="UsunMarke" asp-route-id="@marka.Id" method="post" class="m-0">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Usunięcie marki usunie też jej modele. Jesteś pewien?');">
                                                <i class="bi bi-trash"></i> Usuń
                                            </button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <i class="bi bi-inbox" style="font-size: 2rem; opacity: 0.5;"></i>
                                <p>Brak marek w bazie danych</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Sekcja Modeli -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-secondary text-white p-3">
                    <h2 class="h5 mb-0"><i class="bi bi-bookmark"></i> Zarządzaj Modelami</h2>
                </div>
                <div class="card-body">
                    <form asp-action="DodajModel" method="post" class="mb-4">
                        <div class="form-row-inline">
                            <select name="markaId" class="form-select" asp-items="ViewBag.MarkiList" required>
                                <option value="">Wybierz markę...</option>
                            </select>
                            <input type="text" name="nazwaModelu" class="form-control" placeholder="Nazwa modelu..." required />
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-plus-circle"></i> Dodaj
                            </button>
                        </div>
                    </form>

                    <h5 class="mt-3 mb-3">
                        <i class="bi bi-list-ul"></i> Lista Modeli
                    </h5>
                    <div style="max-height: 450px; overflow-y: auto;">
                        @if (modele != null && modele.Count > 0)
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var m in modele)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                        <div>
                                            <strong class="text-primary">@m.Marka?.Nazwa</strong>
                                            <span class="text-muted"> › </span>
                                            <strong>@m.Nazwa</strong>
                                            <small class="text-muted d-block">ID: @m.Id</small>
                                        </div>
                                        <form asp-action="UsunModel" asp-route-id="@m.Id" method="post" class="m-0">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Na pewno usunąć ten model?');">
                                                <i class="bi bi-trash"></i> Usuń
                                            </button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <i class="bi bi-inbox" style="font-size: 2rem; opacity: 0.5;"></i>
                                <p>Brak modeli w bazie danych</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>